{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    // `noUncheckedIndexedAccess` e `exactOptionalPropertyTypes` ficam DE FORA.
    //
    // Este programa compila também o código do Generate (o Validator e o Judge
    // entram por import, não por cópia), e o tsconfig de lá não liga esses dois
    // flags. Ligá-los aqui faz o `tsc` acusar 20 erros dentro do repositório
    // DELES — erros que não existem sob o tsconfig deles e que o Lab não pode
    // corrigir, porque não escreve naquele repositório.
    //
    // Um typecheck que acusa erro alheio e não tem como consertá-lo é um
    // typecheck que se aprende a ignorar. O código deste adaptador foi escrito
    // e passou com os dois flags ligados; alinhar com o Generate é o que
    // mantém a saída do `tsc` significando alguma coisa.
    "skipLibCheck": true,
    "types": ["bun"],
    "baseUrl": ".",
    // ── ONDE FICAM OS REPOSITÓRIOS IRMÃOS ──────────────────────────────────
    //
    // Este é o ÚNICO lugar do Lab que sabe o caminho deles. Os dois são clones
    // SÓ PARA LEITURA — o Lab nunca escreve neles.
    //
    //   motor-testfit  → jonny583/motor-testfit       (o motor que a esteira mede)
    //   generate       → jonny583/urban-create-hub-41d93a4d
    //                    (o dono do contrato, do Validator e do Judge)
    //
    // Para rodar noutra máquina, clone os dois e ajuste as duas linhas abaixo.
    // Ver external-engines/testfit/README.md.
    "paths": {
      "@testfit/*": ["../../../motor-testfit/src/lib/lab/*"],
      "@generate/*": ["../../../urban-create-hub-41d93a4d/src/lib/*"],
      // O alias DELES, espelhado. Medido no LAB-18: o contrato v2 trouxe
      // `engine/lot-rules.ts` → `empreendimentos/types.ts`, e esse arquivo
      // importa `@/lib/apontar` e `@/lib/funil` — o `@/` é o alias interno do
      // Generate, que o tsconfig deles mapeia e o do Lab não mapeava.
      //
      // Não é defeito deles: um repositório tem o direito de usar o próprio
      // alias no próprio código. Quem lê por caminho é que tem de espelhá-lo, e
      // este é o único lugar do Lab que sabe onde os irmãos ficam.
      "@/*": ["../../../urban-create-hub-41d93a4d/src/*"],
      "@symbios/*": ["../symbios/adapter/src/*"]
    }
  },
  "include": ["src", "ferramentas", "tests", "tipos"]
}
